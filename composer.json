{
  "name": "antevemus/aspecification-br",
  "description": "Brazilian documents for antevemus/aspecification: CPF, CNPJ (alphanumeric too), CEP, phone, vehicle plate, CNJ process, CNH, PIS/PASEP, voter ID, RENAVAM and PIX key, with check digits, exact forms, codec names and failures that never echo the value",
  "type": "library",
  "license": "MIT",
  "homepage": "https://github.com/antevemus-it/Antevemus.ASpecificationBr",
  "support": {
    "source": "https://github.com/antevemus-it/Antevemus.ASpecificationBr",
    "issues": "https://github.com/antevemus-it/Antevemus.ASpecificationBr/issues",
    "docs": "https://github.com/antevemus-it/Antevemus.ASpecificationBr#readme"
  },
  "keywords": [
    "specification",
    "specification-pattern",
    "validation",
    "brazil",
    "cpf",
    "cnpj",
    "cnpj-alfanumerico",
    "cep",
    "mercosul",
    "cnj",
    "cnh",
    "pis",
    "titulo-eleitor",
    "renavam",
    "pix",
    "php82"
  ],
  "authors": [
    {
      "name": "Heliton Junior - CTO @ Antevemus Soluções Inovadoras em TI Ltda.",
      "email": "contato@antevemus.com.br",
      "homepage": "https://antevemus.com.br"
    }
  ],
  "require": {
    "php": "^8.2",
    "antevemus/aspecification": "^2.13"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "infection/infection": "^0.31.9 || ^0.35.6"
  },
  "autoload": {
    "psr-4": {
      "Antevemus\\ASpecificationBr\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Antevemus\\ASpecificationBr\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "allow-plugins": {
      "infection/extension-installer": false
    }
  }
}
