// Mutation testing of antevemus/aspecification-br (1.0.0): the whole src/. Runs in the scheduled workflow
// (.github/workflows/quality.yml) with a coverage driver (pcov); locally:
//
//   XDEBUG_MODE=off vendor/bin/infection --threads=max --only-covering-test-cases \
//       --initial-tests-php-options="-d pcov.enabled=1 -d pcov.directory=$PWD/src"
//
// Measured on 2026-11-12 (1.0.0 against ASpecification 2.13.0, Infection 0.35.10, PHP 8.4.27 with pcov): 328
// mutants, 321 killed, 0 errors, 0 time-outs, 7 escaped, all equivalent: three (int) casts of a digit in an
// arithmetic expression and one of a five-digit prefix compared with an integer (PHP converts a numeric string
// the same way), one (string) cast of a preg_replace() that cannot fail on a string, and two str_repeat($value[1])
// in the repetition checks (equal to the value only when every character is the same, as with $value[0]); MSI
// 97.87%, covered-code MSI 97.87%, mutation code coverage 100%. The minimum scores are one integer point below.
{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": ["src"]
    },
    "timeout": 60,
    "logs": {
        "text": "coverage/infection/infection.log",
        "summary": "coverage/infection/summary.log",
        "json": "coverage/infection/infection.json",
        "perMutator": "coverage/infection/per-mutator.md"
    },
    "tmpDir": "coverage/infection/tmp",
    "phpUnit": {
        "configDir": "."
    },
    "minMsi": 96,
    "minCoveredMsi": 96,
    "mutators": {
        "@default": true
    }
}
